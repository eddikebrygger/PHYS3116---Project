   "source": [
    "R_gc = pd.to_numeric(harris_p1['R_gc'],errors='coerce')\n",
    "R_Sun = pd.to_numeric(harris_p1['R_Sun'],errors='coerce')\n",
    "sig_v = pd.to_numeric(harris_p3['sig_v'],errors='coerce')\n",
    "v_r = pd.to_numeric(harris_p3['v_r'],errors='coerce')\n",
    "mtlc = pd.to_numeric(harris_p2['[Fe/H]'],errors='coerce')\n",
    "\n",
    "mask = mtlc > -0.8"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "e4119c03",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.figure()\n",
    "plt.plot(R_Sun[~mask],v_r[~mask],'.',label=r'$[\\mathrm{Fe/H}] < -0.8$')\n",
    "plt.plot(R_Sun[mask],v_r[mask],'.',label=r'$[\\mathrm{Fe/H}] > - 0.8$')\n",
    "plt.legend()\n",
    "plt.xlabel(r'$R_{\\mathrm{Sun}}/\\mathrm{kpc}$')\n",
    "plt.ylabel(r'$v_r/\\mathrm{km/s}$')\n",
    "plt.grid()\n",
    "plt.xlim(0)\n",
    "plt.title(r'Distribution of globular clusters (as seen from the sun)')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "15357bcc",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from scipy.interpolate import RBFInterpolator\n",
    "RR = np.linspace(R_Sun.min(),R_Sun.max(),1000)\n",
    "VV = np.linspace(v_r.min(),v_r.max(),1000)\n",
    "RR,VV = np.meshgrid(RR,VV)\n",
    "mask2 = np.isnan(R_Sun) | np.isnan(v_r) | np.isnan(mtlc)\n",
    "R_array = R_Sun[~mask2]\n",
    "V_array = v_r[~mask2]\n",
    "M_array = mtlc[~mask2]\n",
    "RV = np.transpose(np.array([R_array,V_array]))\n",
    "rbf = RBFInterpolator(RV,M_array, kernel = 'thin_plate_spline')\n",
    "\n",
    "# MM = griddata(RV,M_array,(RR,VV),method = 'cubic')\n",
    "MM = rbf(np.column_stack((RR.ravel(), VV.ravel()))).reshape(RR.shape)\n",
    "\n",
    "\n",
    "plt.figure()\n",
    "Z_min,Z_max = mtlc.min(), mtlc.max()\n",
    "plt.pcolormesh(RR,VV,MM,cmap='magma',vmin=Z_min,vmax=Z_max)\n",
    "plt.scatter(R_Sun,v_r,1,mtlc,cmap='magma',vmin=Z_min,vmax=Z_max)\n",
    "plt.colorbar(label =r'$[\\mathrm{Fe/H}]$')\n",
    "plt.xlabel(r'$R_{\\mathrm{Sun}}/\\mathrm{kpc}$')\n",
    "plt.ylabel(r'$v_r/\\mathrm{km/s}$')\n",
    "plt.title(r'Interpolated metallicity of globular clusters')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
